# ---------------------------------------------------------------------------
# Rift Lab configuration
#
# Copy to `.env` and adjust. Every value below has a working default for local
# development, so `cp .env.example .env && docker compose up` works as-is.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=local              # local | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# Inside Docker Compose the host is the `postgres` service; running the API on
# your machine against the compose database, use localhost.
DATABASE_URL=postgresql+psycopg://riftlab:riftlab@postgres:5432/riftlab
POSTGRES_USER=riftlab
POSTGRES_PASSWORD=riftlab
POSTGRES_DB=riftlab
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis -----------------------------------------------------------------
# Optional. Used for the shared Riot rate-limit budget and response caching;
# the application degrades gracefully when it is unavailable.
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=900

# --- Riot API --------------------------------------------------------------
# Leave RIOT_API_KEY empty (or set RIOT_USE_MOCK=true) to run against the built-in
# deterministic match simulator. The entire pipeline — ingestion, features,
# cohorts, models — behaves identically either way, so the app is fully usable
# and testable without credentials.
#
# With a real key, get one at https://developer.riotgames.com/. Personal keys
# expire every 24 hours and are limited to 20 req/s and 100 req/2min, which the
# client enforces on your behalf.
RIOT_API_KEY=
RIOT_USE_MOCK=true
RIOT_PLATFORM=na1              # na1 euw1 eun1 kr br1 jp1 la1 la2 oc1 tr1 ru ...
RIOT_TIMEOUT_SECONDS=10
RIOT_MAX_RETRIES=4
RIOT_RATE_LIMIT_SHORT=20
RIOT_RATE_LIMIT_SHORT_WINDOW=1
RIOT_RATE_LIMIT_LONG=100
RIOT_RATE_LIMIT_LONG_WINDOW=120

# --- Ingestion -------------------------------------------------------------
INGEST_DEFAULT_MATCH_COUNT=30
INGEST_MAX_MATCH_COUNT=200
INGEST_QUEUE_IDS=420,440,400   # ranked solo, flex, draft
INGEST_CONCURRENCY=4

# --- ML --------------------------------------------------------------------
MODEL_DIR=/app/models
SKILL_GAP_MIN_SAMPLES=200
RISK_MODEL_GRID_SIZE=32        # heatmap resolution (32x32 cells over the map)
RISK_HORIZON_SECONDS=30        # "died within N seconds" label for the risk model

# --- Frontend --------------------------------------------------------------
# Where the Next.js server reaches the API. In Compose this is the `api` service.
API_INTERNAL_URL=http://api:8000
