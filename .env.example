# ---------------------------------------------------------------------------
# AoE2 Analytics Platform configuration
#
# Copy to `.env` and adjust. Every value below has a working default for local
# development, so `cp .env.example .env && docker compose up` works as-is.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=local              # local | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# Inside Docker Compose the host is the `postgres` service; running the API on
# your machine against the compose database, use localhost.
DATABASE_URL=postgresql+psycopg://aoe2:aoe2@postgres:5432/aoe2
POSTGRES_USER=aoe2
POSTGRES_PASSWORD=aoe2
POSTGRES_DB=aoe2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis -----------------------------------------------------------------
# Used for background replay processing job queue and caching.
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=900
JOB_QUEUE_NAME=aoe2_replays

# --- Replay Processing -----------------------------------------------------
REPLAY_STORAGE_PATH=/data/replays          # Local storage for uploaded replays
REPLAY_PARSER_TIMEOUT_SECONDS=300
MAX_REPLAY_SIZE_MB=100
REPLAY_PARSER_TYPE=aoc_mgz                 # aoc_mgz | mgz | other

# --- Analytics Configuration -----------------------------------------------
# Game state snapshot interval (seconds)
GAME_STATE_SNAPSHOT_INTERVAL_SECONDS=10
# Rebuild interval for peer comparison cohorts
PEER_COHORT_REBUILD_HOURS=24

# --- ML Models & Feature Engineering ---------------------------------------
MODEL_DIR=/app/models
SKILL_GAP_MIN_SAMPLES=100              # Minimum games for percentile calculation
SKILL_GAP_ELO_BANDS=1000,1200,1400,1600,1800,2000,9999
ENABLE_ML_MODELS=true
ML_MODEL_VERSION=v1

# --- Feature Versioning (for reproducibility) -----
ANALYTICS_FEATURE_VERSION=1
METRICS_SNAPSHOT_VERSION=1

# --- Logging ---------------------------------------------------------------
STRUCTURED_LOGGING=true                # JSON logs for production
LOG_REQUESTS=false
LOG_SLOW_QUERIES_MS=1000

# --- Frontend --------------------------------------------------------------
# Where the Next.js server reaches the API. In Compose this is the `api` service.
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Worker ----------------------------------------------------------------
WORKER_PROCESSES=2
WORKER_CONCURRENCY=4
